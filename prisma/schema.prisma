// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id        Int      @id @default(autoincrement())
  name      String
  subdomain String   @unique
  logo      String?
  email     String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  classes Class[]
  videos  Video[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SUPER_ADMIN)
  studentId String?
  schoolId  Int
  classId   Int?
  arm       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  class  Class? @relation(fields: [classId], references: [id])

  @@index([schoolId])
  @@index([classId])
}

enum Role {
  SUPER_ADMIN
  STUDENT
  ADMIN
  TEACHER
}

model Class {
  id        Int      @id @default(autoincrement())
  grade     String
  arms      String[]
  schoolId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School  @relation(fields: [schoolId], references: [id])
  students User[]
  videos   Video[]

  @@index([schoolId])
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  url         String
  subject     String
  schoolId    Int
  classId     Int
  duration    Int?
  uploadedAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  class  Class  @relation(fields: [classId], references: [id])

  @@index([schoolId])
  @@index([classId])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  plan      Plan     @default(MONTHLY)
  status    Status   @default(ACTIVE)
  startDate DateTime @default(now())
  endDate   DateTime
  amount    Int // Amount in kobo (₦500 = 50000 kobo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Plan {
  MONTHLY
  TERMLY
}

enum Status {
  ACTIVE
  EXPIRED
  TRIAL
}
