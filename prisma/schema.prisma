generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id             Int      @id @default(autoincrement())
  name           String
  subdomain      String   @unique
  studentCounter Int      @default(0)
  logo           String?
  email          String
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  classes        Class[]
  users          User[]
  videos         Video[]
  arms           Arm[]

  @@index([isActive])
}

model User {
  id               Int             @id @default(autoincrement())
  name             String
  email            String?         @unique
  phoneNumber      String?         @unique
  password         String?
  profilePicture   String?
  dateOfBirth      DateTime?
  role             Role            @default(TEACHER)
  studentId        String?         @unique
  schoolId         Int?
  classId          Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isActive         Boolean         @default(true)
  armId            Int?
  classes          Class[]         @relation("ClassTeacher")
  teachingSubjects Subject[]
  arm              Arm?            @relation(fields: [armId], references: [id])
  class            Class?          @relation("StudentClass", fields: [classId], references: [id])
  school           School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  videoProgresses  VideoProgress[]

  @@index([schoolId])
  @@index([classId])
  @@index([armId])
  @@index([studentId])
  @@index([schoolId, role, isActive]) // ✅ ADD THIS (for filtering students by school and status)
  @@index([classId, role]) // ✅ ADD THIS (for getting students in a class)
}

model Class {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  isActive  Boolean   @default(true)
  teacherId Int?
  arms      Arm[]
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher   User?     @relation("ClassTeacher", fields: [teacherId], references: [id])
  subjects  Subject[]
  students  User[]    @relation("StudentClass")
  videos    Video[]

  @@index([schoolId])
  @@index([schoolId, isActive])
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String
  classId   Int
  teacherId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   User?    @relation(fields: [teacherId], references: [id])
  materials Video[]

  @@index([classId])
  @@index([teacherId])
}

model Arm {
  id        Int      @id @default(autoincrement())
  name      String
  schoolId  Int?
  classId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  User[]
  materials Video[]
}

model Video {
  id              Int             @id @default(autoincrement())
  title           String
  description     String?
  url             String
  schoolId        Int?
  classId         Int
  duration        Int?
  uploadedAt      DateTime        @default(now())
  armId           Int?
  subjectId       Int?
  arm             Arm?            @relation(fields: [armId], references: [id])
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  school          School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject         Subject?        @relation(fields: [subjectId], references: [id])
  videoProgresses VideoProgress[]

  @@index([schoolId])
  @@index([classId, uploadedAt])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  plan      Plan     @default(MONTHLY)
  status    Status   @default(ACTIVE)
  startDate DateTime @default(now())
  endDate   DateTime
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VideoProgress {
  id              Int      @id @default(autoincrement())
  studentId       Int
  videoId         Int
  watchedDuration Int      @default(0) // Seconds watched
  progressPercent Int      @default(0) // Percentage watched (0-100)
  isCompleted     Boolean  @default(false) // True if watched >= 90%
  lastWatchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId]) // Each student has one progress record per video
  @@index([studentId])
  @@index([videoId])
  @@index([lastWatchedAt])
  @@index([studentId, lastWatchedAt])
  @@index([studentId, isCompleted])
}

enum Role {
  SUPER_ADMIN
  STUDENT
  ADMIN
  TEACHER
}

enum Plan {
  MONTHLY
  TERMLY
}

enum Status {
  ACTIVE
  EXPIRED
  TRIAL
}
